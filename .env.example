# ═══════════════════════════════════════════════════
# PequeñosCRM Pro — Variables de entorno (EJEMPLO)
# Copiar este archivo como .env y completar los valores
# ═══════════════════════════════════════════════════

PORT=3000
NODE_ENV=development
JWT_SECRET=
SA_SECRET=
CONFIG_ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ── Seed passwords (cambiar en producción) ──
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
# ── SMTP (opcional, para emails de recuperación y notificaciones) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Nico
# ── MercadoPago (también configurable desde SuperAdmin → Pagos) ──
# Si se configura desde el panel, estos valores son fallback.
# MP_ACCESS_TOKEN=TEST-... o APP_USR-...
# MP_PUBLIC_KEY=
# MP_WEBHOOK_SECRET=
# MP_CURRENCY=ARS
# APP_URL=https://app.flexcrm.com.ar

# ── URLs ──
TUTORIALES_URL=

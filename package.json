{
  "name": "pequenoscrm-pro",
  "version": "2.47.0",
  "description": "FlexCRM — CRM multi-rubro SaaS multi-tenant",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:react": "cd frontend && npm run dev",
    "build:react": "cd frontend && npm install && npm run build",
    "setup": "npm install && cd frontend && npm install",
    "test": "npx vitest run && cd frontend && npm test",
    "test:backend": "node --test test/backend.test.js",
    "test:watch": "cd frontend && npm run test:watch",
    "test:coverage": "cd frontend && npm run test:coverage",
    "doctor": "npx react-doctor@latest",
    "build": "cd frontend && npm install && npm run build"
  },
  "dependencies": {
    "@afipsdk/afip.js": "^1.2.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "pdfkit": "^0.19.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
